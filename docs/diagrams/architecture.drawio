        </mxCell>
        <mxCell id="ra" value="Role Assignment&#10;Storage Blob Data Contributor&#10;(scoped to storage account)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="1">
          <mxGeometry x="430" y="370" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Source cluster -->
        <mxCell id="src" value="Source AKS Cluster" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="vs" value="Velero + Azure plugin&#10;(CSI snapshots)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="110" y="160" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ssa" value="ServiceAccount: velero&#10;(Workload Identity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="110" y="230" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sch" value="Backup Schedules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="110" y="295" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Destination cluster -->
        <mxCell id="dst" value="Destination AKS Cluster" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff8e1;strokeColor=#f9a825;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="vd" value="Velero + Azure plugin&#10;(CSI restore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffecb3;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="790" y="160" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dsa" value="ServiceAccount: velero&#10;(Workload Identity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffecb3;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="790" y="230" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="writes backups" style="endArrow=block;html=1;strokeColor=#2e7d32;fontSize=11;" edge="1" parent="1" source="sch" target="ct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="reads / restores" style="endArrow=block;html=1;strokeColor=#f9a825;fontSize=11;" edge="1" parent="1" source="vd" target="ct">
