<mxfile host="app.diagrams.net" type="device">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1100" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Azure boundary -->
        <mxCell id="az" value="Azure Subscription" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1020" height="620" as="geometry" />
        </mxCell>

        <!-- Backup resource group -->
        <mxCell id="rg" value="Resource Group: backup" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="90" width="300" height="360" as="geometry" />
        </mxCell>
        <mxCell id="sa" value="Storage Account&#10;(TLS1.2, infra encryption,&#10;soft-delete, versioning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ct" value="Blob Container: velero&#10;(prefix: source/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mi" value="User-Assigned&#10;Managed Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;" vertex="1" parent="1">
